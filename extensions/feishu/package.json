{
  "name": "@allbot/feishu",
  "version": "2026.4.10",
  "description": "AllBot Feishu/Lark channel plugin (community maintained by @m1heng)",
  "type": "module",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "typebox": "^1.1"
  },
  "devDependencies": {
    "@allbot/plugin-sdk": "workspace:*",
    "allbot": "workspace:*"
  },
  "peerDependencies": {
    "allbot": ">=2026.4.10"
  },
  "peerDependenciesMeta": {
    "allbot": {
      "optional": true
    }
  },
  "allbot": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "feishu",
      "label": "Feishu",
      "selectionLabel": "Feishu/Lark (飞书)",
      "docsPath": "/channels/feishu",
      "docsLabel": "feishu",
      "blurb": "飞书/Lark enterprise messaging with doc/wiki/drive tools.",
      "aliases": [
        "lark"
      ],
      "order": 35,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@allbot/feishu",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.4.10"
    },
    "build": {
      "allbotVersion": "2026.4.17"
    },
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
