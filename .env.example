# AllBot Simplify .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.allbot/.env` (for systemd/launchd).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence (highest -> lowest):
# process env, ./.env, ~/.allbot/.env, then allbot.json `env` block.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
ALLBOT_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# ALLBOT_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# ALLBOT_STATE_DIR=~/.allbot
# ALLBOT_CONFIG_PATH=~/.allbot/allbot.json
# ALLBOT_HOME=~

# -----------------------------------------------------------------------------
# Z.AI (智谱 GLM) — default LLM provider
# -----------------------------------------------------------------------------
ZAI_API_KEY=your-zai-api-key
# Get your key at: https://open.bigmodel.cn/

# -----------------------------------------------------------------------------
# Feishu (飞书) — default messaging channel
# -----------------------------------------------------------------------------
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# These can also be set via: allbot config set channels.feishu.appId "xxx"

# -----------------------------------------------------------------------------
# OpenAI compatible (optional, as fallback provider)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...

# Web search (optional — enables real-time insight generation)
# EXA_API_KEY=...
# TAVILY_API_KEY=...

# -----------------------------------------------------------------------------
# Docker (required for docker-compose, ignored for local runs)
# -----------------------------------------------------------------------------
# ALLBOT_STATE_DIR=/home/node/.allbot
# ALLBOT_WORKSPACE_DIR=/home/node/.allbot/workspace

# -----------------------------------------------------------------------------
# npm install behavior (postinstall)
# -----------------------------------------------------------------------------
# `npm install allbot` runs a postinstall hook that:
#   1. Restores bundled-extension runtime deps (e.g. @larksuiteoapi/node-sdk)
#      into the package root so bundled channels (feishu) work out of the box.
#   2. Installs lark-cli skills (~28 SKILL.md files) to ~/.agents/skills/ via
#      `npx -y skills add larksuite/cli -g --all`.
# Both fetch third-party npm packages at install time. Set these to skip:
# ALLBOT_DISABLE_BUNDLED_PLUGIN_POSTINSTALL=1   # skip (1) entirely
# ALLBOT_DISABLE_LARK_SKILLS_INSTALL=1          # skip (2) only

# -----------------------------------------------------------------------------
# Config clobber protection
# -----------------------------------------------------------------------------
# Refuse to shrink allbot.json by >50% relative to the last-known-good
# snapshot when the prior config had a configured gateway. Set to "1" only if
# you intentionally want to overwrite a real config with a stub (e.g. wiping a
# test instance). The default (unset) protects against accidental clobbers
# from env-var typos (e.g. setting ALLBOT_CONFIG_DIR which is not honored;
# the correct name is ALLBOT_STATE_DIR).
# ALLBOT_ALLOW_CONFIG_CLOBBER_SHRINK=1
